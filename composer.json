{
    "name": "leoness/agent-sdk",
    "description": "Kontrakty balíkov MCP nástrojov platformy Leoness AI: porty platformy, potvrdenie akcie, hodnotové objekty a enumy.",
    "type": "library",
    "license": "proprietary",
    "require": {
        "php": ">=8.4",
        "symfony/ai-agent": "^0.13",
        "symfony/dependency-injection": "^7.2|^8.0",
        "symfony/translation-contracts": "^3.0"
    },
    "require-dev": {
        "phpunit/phpunit": "^13.0"
    },
    "autoload": {
        "psr-4": {
            "Leoness\\AgentSdk\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Leoness\\AgentSdk\\Tests\\": "tests/"
        }
    },
    "config": {
        "sort-packages": true
    },
    "scripts": {
        "test": "phpunit"
    }
}
