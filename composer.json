{
    "name": "leoness/agent-sdk",
    "description": "Kontrakty agentov platformy Leoness AI: čisté DTO, enumy a zdieľané validačné pravidlá manifestu.",
    "type": "library",
    "license": "proprietary",
    "require": {
        "php": ">=8.4",
        "psr/cache": "^3.0",
        "symfony/dependency-injection": "^7.2|^8.0",
        "symfony/expression-language": "^7.2|^8.0",
        "symfony/translation-contracts": "^3.0"
    },
    "require-dev": {
        "phpunit/phpunit": "^13.0"
    },
    "autoload": {
        "psr-4": {
            "Leoness\\AgentSdk\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Leoness\\AgentSdk\\Tests\\": "tests/"
        }
    },
    "config": {
        "sort-packages": true
    },
    "scripts": {
        "test": "phpunit"
    }
}
